{
  "name": "easy-visa",
  "version": "1.0.0",
  "description": "Easy Visa — bilingual travel & visa request platform (Mukalla, Yemen)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest run --config ./vitest.config.mts",
    "ci": "payload migrate && npm run build",
    "seed": "node --no-deprecation --env-file=.env --import tsx/esm src/seed/run.ts",
    "db:up": "docker compose up -d postgres",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/dev-db.mjs --test",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/email-nodemailer": "^3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/translations": "^3.94.2",
    "@payloadcms/ui": "3.94.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "file-type": "^22.3.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.16.1",
    "payload": "3.94.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.92.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "embedded-postgres": "^19.0.0-beta.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12"
  }
}

# Copy to .env.production on the server and fill in real values. Never commit it.
DOMAIN=easyvisa.example
NEXT_PUBLIC_SITE_URL=https://easyvisa.example

POSTGRES_USER=easyvisa
POSTGRES_PASSWORD=change-to-a-long-random-password
POSTGRES_DB=easyvisa

# 64+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# Email for new-request notifications (optional but recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@easyvisa.example
EMAIL_FROM_NAME=Easy Visa
ADMIN_NOTIFY_EMAIL=
